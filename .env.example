# ============================================================================
# MineBuild Environment Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.
# ============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Safe for client browsers)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Secret Key (SERVER-ONLY: NEVER expose to client code)
# Used by server API route handlers to store messages and manage moderation.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Admin Secret Key for Owner Message Inspection API (/api/admin/messages)
ADMIN_SECRET_KEY=generate-a-secure-random-secret-here
